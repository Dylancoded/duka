rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/{allPaths=**} {
      allow read, write: if request.auth != null && firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
