rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberOf(businessId) {
      return signedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }
    function roleAtLeast(businessId, role) {
      return memberOf(businessId) && (
        role == 'cashier' ||
        get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role in ['owner', 'manager']
      );
    }

    match /businesses/{businessId} {
      allow read: if memberOf(businessId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if memberOf(businessId) && (request.resource.data.billing == resource.data.billing || roleAtLeast(businessId, 'manager'));
      match /members/{uid} { allow read: if memberOf(businessId); allow write: if roleAtLeast(businessId, 'manager'); }
      match /branches/{branchId} { allow read, write: if memberOf(businessId); }
      match /products/{productId} { allow read: if memberOf(businessId); allow write: if roleAtLeast(businessId, 'cashier'); }
      match /sales/{saleId} { allow read, create: if memberOf(businessId); allow update, delete: if roleAtLeast(businessId, 'manager'); }
      match /customers/{customerId} { allow read, write: if memberOf(businessId); }
      match /expenses/{expenseId} { allow read: if memberOf(businessId); allow write: if roleAtLeast(businessId, 'manager'); }
      match /taxInvoices/{invoiceId} { allow read: if memberOf(businessId); allow write: if roleAtLeast(businessId, 'manager'); }
      match /syncQueue/{operationId} { allow read, create: if memberOf(businessId); allow update: if roleAtLeast(businessId, 'manager'); }
      match /auditEvents/{eventId} { allow read: if roleAtLeast(businessId, 'manager'); allow create: if memberOf(businessId); }
    }
    match /billingPlans/{planId} { allow read, write: if false; }
    match /billingTokens/{tokenId} { allow read, write: if false; }
    match /billingRtdn/{eventId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
